{
  "buildCommand": "npm run build && uv run python manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "functions": {
    "nama_project/wsgi.py": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app/wsgi.py"
    }
  ]
}
