{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "resources",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@s:app/*": [
        "./app/static/app/*"
      ],
      "@t:app/*": [
        "./app/templates/app/*"
      ],
      "@s:authentication/*": [
        "./authentication/static/authentication/*"
      ],
      "@t:authentication/*": [
        "./authentication/templates/authentication/*"
      ],
      "@s:core/*": [
        "./core/static/core/*"
      ],
      "@t:core/*": [
        "./core/templates/core/*"
      ]
    }
  },
  "include": ["resources"]
}
